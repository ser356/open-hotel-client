{
  "name": "@open-hotel/client",
  "license": "MIT",
  "scripts": {
    "changelog": "conventional-changelog -p angular -r 2 -i CHANGELOG.md -s",
    "dev": "webpack serve --mode development",
    "postinstall": "node scripts/patch-pixel.js",
    "start": "sh start.sh",
    "build": "NODE_ENV=production webpack && cp public/worker.js dist/worker.js"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "husky": {
    "hooks": {
      "prepare-commit-msg": "exec < /dev/tty && git cz --hook || true"
    }
  },
  "devDependencies": {
    "@types/url-join": "^4.0.0",
    "commitizen": "^4.0.3",
    "css-loader": "5.2.7",
    "cz-conventional-changelog": "3.0.2",
    "dotenv": "^8.2.0",
    "gstats": "^0.1.0",
    "html-webpack-plugin": "^5.6.8",
    "husky": "^3.0.5",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "vue-loader": "^15.11.1",
    "vue-style-loader": "4.1.3",
    "vue-template-compiler": "^2.7.16",
    "webpack": "^5.111.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.3"
  },
  "dependencies": {
    "@open-hotel/pixel": "^0.2.7",
    "@pixi/unsafe-eval": "5.3.12",
    "@tweenjs/tween.js": "^18.6.0",
    "events": "^3.0.0",
    "injets": "^1.2.5",
    "lodash.clonedeep": "^4.5.0",
    "pixi-cull": "^1.0.0",
    "pixi-viewport": "^4.13.2",
    "pixi.js": "^5.3.3",
    "reflect-metadata": "^0.1.13",
    "stylus": "^0.64.0",
    "stylus-loader": "^9.0.0",
    "url-join": "^4.0.1",
    "vue": "^2.7.16",
    "vue-class-component": "^7.2.5",
    "vue-property-decorator": "^9.0.0",
    "vue-router": "^3.1.3",
    "vuex": "^3.1.2"
  }
}
